{
  "routes": [
    {"name": "nlp.classify",   "handler": "handler.classify_text",    "method": "POST"},
    {"name": "nlp.sentiment",  "handler": "handler.analyze_sentiment", "method": "POST"},
    {"name": "nlp.ner",        "handler": "handler.extract_entities",  "method": "POST"},
    {"name": "nlp.tokenize",   "handler": "handler.tokenize",          "method": "POST"},
    {"name": "nlp.summarize",  "handler": "handler.summarize",         "method": "POST"}
  ],
  "fallback": "handler.default",
  "internal_routing": {
    "classify_text":    "executor.run_classifier",
    "analyze_sentiment":"executor.run_sentiment",
    "extract_entities": "executor.run_ner",
    "tokenize":         "executor.run_tokenizer",
    "summarize":        "executor.run_summarizer"
  }
}
